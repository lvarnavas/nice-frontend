# Copy this file to .env.development (local) or .env.production (deploy).
# Create React App only exposes variables prefixed with REACT_APP_.
#
# Anything placed here is embedded into the JavaScript bundle at build time
# and is therefore publicly visible. Never put secrets in this file.

# Base URL of the Nice backend API.
# Local development:  http://localhost:5001/api
# Production:         https://your-domain.example/api
REACT_APP_BACKEND_URL=http://localhost:5001/api
